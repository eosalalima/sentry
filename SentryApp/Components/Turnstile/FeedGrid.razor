@using SentryApp.Services

<div class="feed-grid">
    <div class="feed-grid-section">
        <div class="feed-grid-section-label">IN</div>
        @if (InEntries.Count > 0)
        {
            <div class="feed-grid-rows">
                @foreach (var row in Chunk(InEntries, 5))
                {
                    <div class="feed-grid-row">
                        @foreach (var entry in row)
                        {
                            <FeedCard Entry="entry" />
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="feed-grid-empty">No recent IN logs.</div>
        }
    </div>

    <div class="feed-grid-divider"></div>

    <div class="feed-grid-section">
        <div class="feed-grid-section-label">OUT / BREAKOUT</div>
        @if (OutEntries.Count > 0)
        {
            <div class="feed-grid-rows">
                @foreach (var row in Chunk(OutEntries, 5))
                {
                    <div class="feed-grid-row">
                        @foreach (var entry in row)
                        {
                            <FeedCard Entry="entry" />
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="feed-grid-empty">No recent OUT or BREAKOUT logs.</div>
        }
    </div>
</div>

@code {
    private const string AllDevicesValue = "1";

    [Parameter] public IReadOnlyList<TurnstileQueueItem> Items { get; set; } = Array.Empty<TurnstileQueueItem>();
    [Parameter] public string SelectedDeviceSerial { get; set; } = AllDevicesValue;

    private List<TurnstileLogEntry> InEntries =>
        FilteredItems
             .Where(item => TurnstileLogTypeClassifier.IsIn(item.Entry.LogType))
            .OrderByDescending(item => item.EnqueuedAt)
            .Select(item => item.Entry)
            .ToList();

    private List<TurnstileLogEntry> OutEntries =>
        FilteredItems
             .Where(item => TurnstileLogTypeClassifier.IsOutFamily(item.Entry.LogType))
            .OrderByDescending(item => item.EnqueuedAt)
            .Select(item => item.Entry)
            .ToList();

    private IEnumerable<TurnstileQueueItem> FilteredItems =>
        Items.Where(item => ShouldDisplay(item.Entry));

    private static IEnumerable<List<TurnstileLogEntry>> Chunk(List<TurnstileLogEntry> entries, int size)
    {
        for (var i = 0; i < entries.Count; i += size)
            yield return entries.Skip(i).Take(size).ToList();
    }

    private bool ShouldDisplay(TurnstileLogEntry entry)
    {
        if (SelectedDeviceSerial == AllDevicesValue)
            return true;

        return !string.IsNullOrWhiteSpace(entry.DeviceSerialNumber)
            && string.Equals(entry.DeviceSerialNumber, SelectedDeviceSerial, StringComparison.OrdinalIgnoreCase);
    }
}
