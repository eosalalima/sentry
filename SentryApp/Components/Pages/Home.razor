@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject SentryApp.Services.TurnstileLogState State

@using SentryApp.Components.Turnstile

<div class="mon-page">
    <MonitoringHeader />

    @if (State.DeviceSnapshots.Count == 0)
    {
        <div class="device-monitors-empty">Waiting for logs from monitored devices…</div>
    }
    else
    {
        <div class="device-monitors">
            @foreach (var device in State.DeviceSnapshots)
            {
                <DeviceMonitorPanel @key="device.DeviceSerialNumber" Device="device" />
            }
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
    }
}
