@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject SentryApp.Services.TurnstileLogState State
@inject IConfiguration Configuration

@using Microsoft.Extensions.Configuration
@using SentryApp.Components.Turnstile
@using SentryApp.Services

<div class="mon-page">
    <MonitoringHeader />

    @if (MonitoredDeviceSnapshots.Count == 0)
    {
        <div class="device-monitors-empty">Waiting for logs from the selected device…</div>
    }
    else
    {
        <div class="device-monitors">
            @foreach (var device in MonitoredDeviceSnapshots)
            {
                <DeviceMonitorPanel @key="device.DeviceSerialNumber" Device="device" />
            }
        </div>
    }
</div>

@code {
    private IReadOnlyList<DeviceMonitorSnapshot> MonitoredDeviceSnapshots => State.DeviceSnapshots
        .Where(device => DeviceSelection.Matches(
            Configuration.GetValue<string>("SelectedDeviceSerial"),
            device.DeviceSerialNumber))
        .ToList();

    protected override void OnInitialized()
    {
        State.Changed += OnStateChanged;
    }

    private void OnStateChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        State.Changed -= OnStateChanged;
    }
}
