@page "/personnel"
@rendermode InteractiveServer
@using Microsoft.Extensions.Configuration
@using SentryApp.Data.Query
@using SentryApp.Services
@inject PersonnelManagementService PersonnelService
@inject IPhotoUrlBuilder PhotoUrlBuilder
@inject IConfiguration Configuration

<PageTitle>Personnel Management</PageTitle>

<div class="personnel-page">
    <header class="personnel-header">
        <div>
            <h1>Personnel Management</h1>
            <p>View personnel records and maintain SMS contact numbers.</p>
        </div>
        <a class="btn btn-outline-secondary" href="/">Back to Monitoring</a>
    </header>

    <div class="personnel-card">
        <div class="personnel-toolbar">
            <label class="visually-hidden" for="personnelSearch">Search personnel</label>
            <input id="personnelSearch" class="form-control" type="search" placeholder="Search personnel..."
                   @bind="_search" @bind:event="oninput" @onkeyup="HandleSearchKeyUp" />
            <button class="btn btn-primary" type="button" @onclick="SearchAsync" disabled="@_isLoading">Search</button>
        </div>

        @if (!string.IsNullOrEmpty(_successMessage))
        {
            <div class="alert alert-success" role="status">@_successMessage</div>
        }
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }
        else if (_isLoading)
        {
            <div class="personnel-state" role="status">
                <div class="spinner-border text-primary" aria-hidden="true"></div>
                <span>Loading personnel...</span>
            </div>
        }
        else if (_records.Count == 0)
        {
            <div class="personnel-state">
                @if (string.IsNullOrWhiteSpace(_appliedSearch))
                {
                    <span>No personnel records exist.</span>
                }
                else
                {
                    <span>No records match “@_appliedSearch”.</span>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle personnel-table">
                    <thead>
                        <tr>
                            <th scope="col">Photo</th>
                            <th>Personnel Number</th>
                            <th>Last Name</th>
                            <th>First Name</th>
                            <th>SMS Contact Number</th>
                            <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in _records)
                        {
                            <tr>
                                <td>
                                    <img class="personnel-photo"
                                         src="@PhotoUrlBuilder.Build(record.PhotoId)"
                                         alt="Photo of @GetDisplayName(record)"
                                         loading="lazy" />
                                </td>
                                <td>@record.PersonnelNo</td>
                                <td>@record.LastName</td>
                                <td>@record.FirstName</td>
                                <td>@record.SmsContactNumber</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary" type="button" title="Edit SMS Contact Number"
                                            aria-label="Edit SMS Contact Number for @record.FirstName @record.LastName" @onclick="() => OpenEdit(record)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10A.5.5 0 0 1 5.5 14H2a.5.5 0 0 1-.5-.5V10a.5.5 0 0 1 .146-.354zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zM12.793 5.5 10.5 3.207 2.5 11.207V13h1.793z" />
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="personnel-pagination">
                <span>Showing @FirstRecord–@LastRecord of @_totalCount (@_pageSize per page)</span>
                <nav aria-label="Personnel pagination">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(_page == 1 ? "disabled" : null)">
                            <button class="page-link" type="button" disabled="@(_page == 1)" @onclick="PreviousPageAsync">Previous</button>
                        </li>
                        @foreach (var pageNumber in VisiblePageNumbers)
                        {
                            <li class="page-item @(pageNumber == _page ? "active" : null)" aria-current="@(pageNumber == _page ? "page" : null)">
                                <button class="page-link" type="button" @onclick="() => GoToPageAsync(pageNumber)">@pageNumber</button>
                            </li>
                        }
                        <li class="page-item @(_page >= TotalPages ? "disabled" : null)">
                            <button class="page-link" type="button" disabled="@(_page >= TotalPages)" @onclick="NextPageAsync">Next</button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@if (_editingRecord is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="editMobileTitle">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="editMobileTitle">Edit SMS Contact Number</h2>
                    <button type="button" class="btn-close" aria-label="Close" disabled="@_isSaving" @onclick="CancelEdit"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_saveError))
                    {
                        <div class="alert alert-danger" role="alert">@_saveError</div>
                    }
                    <div class="mb-3">
                        <label class="form-label" for="editId">Personnel Number</label>
                        <input id="editId" class="form-control" value="@_editingRecord.PersonnelNo" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="editLastName">Last Name</label>
                        <input id="editLastName" class="form-control" value="@_editingRecord.LastName" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="editFirstName">First Name</label>
                        <input id="editFirstName" class="form-control" value="@_editingRecord.FirstName" readonly />
                    </div>
                    <div>
                        <label class="form-label" for="editMobile">SMS Contact Number</label>
                        <input id="editMobile" class="form-control" type="tel" maxlength="@PersonnelManagementService.SmsContactNumberMaxLength"
                               @bind="_editedMobileNumber" @bind:event="oninput" />
                        <div class="form-text">Up to @PersonnelManagementService.SmsContactNumberMaxLength characters. If left blank, the STAFF or STUDENT directory number is used.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" type="button" disabled="@_isSaving" @onclick="SaveAsync">
                        @(_isSaving ? "Saving..." : "Save")
                    </button>
                    <button class="btn btn-secondary" type="button" disabled="@_isSaving" @onclick="CancelEdit">Cancel</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private const int DefaultPageSize = 50;
    private IReadOnlyList<PersonnelManagementRecord> _records = [];
    private PersonnelManagementRecord? _editingRecord;
    private string _search = string.Empty;
    private string _appliedSearch = string.Empty;
    private string _editedMobileNumber = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _saveError;
    private int _page = 1;
    private int _pageSize = DefaultPageSize;
    private int _totalCount;
    private bool _isLoading = true;
    private bool _isSaving;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_totalCount / (double)_pageSize));
    private int FirstRecord => _totalCount == 0 ? 0 : ((_page - 1) * _pageSize) + 1;
    private int LastRecord => Math.Min(_page * _pageSize, _totalCount);
    private static string GetDisplayName(PersonnelManagementRecord record)
    {
        var displayName = $"{record.FirstName} {record.LastName}".Trim();
        return string.IsNullOrWhiteSpace(displayName) ? record.PersonnelNo : displayName;
    }

    private IEnumerable<int> VisiblePageNumbers
    {
        get
        {
            var firstPage = Math.Max(1, _page - 2);
            var lastPage = Math.Min(TotalPages, firstPage + 4);
            firstPage = Math.Max(1, lastPage - 4);
            return Enumerable.Range(firstPage, lastPage - firstPage + 1);
        }
    }

    protected override Task OnInitializedAsync()
    {
        _pageSize = Math.Clamp(Configuration.GetValue("PersonnelManagement:ItemsPerPage", DefaultPageSize), 1, 100);
        return LoadAsync();
    }

    private async Task SearchAsync()
    {
        _appliedSearch = _search.Trim();
        _page = 1;
        _successMessage = null;
        await LoadAsync();
    }

    private async Task HandleSearchKeyUp(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await SearchAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var result = await PersonnelService.GetPersonnelAsync(_appliedSearch, _page, _pageSize);
            _records = result.Records;
            _totalCount = result.TotalCount;
        }
        catch
        {
            _records = [];
            _totalCount = 0;
            _errorMessage = "Personnel records could not be loaded. Please try again or contact your administrator.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenEdit(PersonnelManagementRecord record)
    {
        _editingRecord = record;
        _editedMobileNumber = record.SmsContactNumber ?? string.Empty;
        _saveError = null;
    }

    private void CancelEdit()
    {
        if (_isSaving)
            return;
        _editingRecord = null;
        _editedMobileNumber = string.Empty;
        _saveError = null;
    }

    private async Task SaveAsync()
    {
        if (_editingRecord is null || _isSaving)
            return;
        var normalizedMobile = _editedMobileNumber.Trim();
        if (normalizedMobile.Length > PersonnelManagementService.SmsContactNumberMaxLength)
        {
            _saveError = $"SMS contact number cannot exceed {PersonnelManagementService.SmsContactNumberMaxLength} characters.";
            return;
        }

        _isSaving = true;
        _saveError = null;
        try
        {
            await PersonnelService.UpdateSmsContactNumberAsync(_editingRecord.PersonnelNo, normalizedMobile);
            _editingRecord = null;
            await LoadAsync();
            _successMessage = "SMS contact number updated successfully.";
        }
        catch
        {
            _saveError = "The SMS contact number could not be saved. Please try again or contact your administrator.";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task PreviousPageAsync()
    {
        if (_page <= 1) return;
        _page--;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (_page >= TotalPages) return;
        _page++;
        await LoadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        if (page == _page || page < 1 || page > TotalPages) return;
        _page = page;
        await LoadAsync();
    }
}
